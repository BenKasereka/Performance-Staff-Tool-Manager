# Base de données PostgreSQL (Neon — plan gratuit)
# URL avec pooler, utilisée par l'application
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# URL directe (sans pooler), utilisée par les migrations Prisma
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js
# Générer avec : npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire"
# En production, mettre l'URL Vercel (ex. https://mon-app.vercel.app)
AUTH_URL="http://localhost:3000"

# Resend (notifications email) — étape 5
RESEND_API_KEY=""
EMAIL_FROM="Suivi Performance <onboarding@resend.dev>"

# Secret protégeant les routes de cron Vercel — étape 5
CRON_SECRET="remplacez-moi-par-un-secret-aleatoire"
